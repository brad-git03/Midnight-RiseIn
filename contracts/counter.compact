// =============================================================================
// MIDNIGHT PRIVACY MODEL & CONTRACT OVERVIEW: PRIVACY COUNTER
// =============================================================================
// PUBLIC LEDGER STATE:
//   - `counter`: Opaque<"string"> (stored on-chain, visible to anyone on the blockchain).
//
// PRIVATE WITNESS (CIRCUIT INPUT):
//   - `secretIncrement`: witness function returning Opaque<"string">.
//   - The private input remains strictly local on the user's client machine.
//   - Never sent to the Midnight blockchain or exposed off-chain.
//
// DISCLOSE USE:
//   - `disclose(value)` is deliberately used to publish only the calculated
//     value to the public `counter` state on-chain, satisfying
//     Compact's private-by-default requirement.
// =============================================================================

pragma language_version >= 0.23;

import CompactStandardLibrary;

// Public ledger state - visible on blockchain
export ledger counter: Opaque<"string">;

// Private witness function declaration for circuit input
witness secretIncrement(): Opaque<"string">;

// Circuit to increment the counter using private witness input
export circuit increment(val: Opaque<"string">): [] {
    const witnessVal = secretIncrement();
    counter = disclose(val);
}
